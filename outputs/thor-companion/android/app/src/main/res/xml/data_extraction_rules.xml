<?xml version="1.0" encoding="utf-8"?>
<!-- Pairing state, the saved Thor and network credentials are tied to this
     phone's Bluetooth bond and Keystore keys. Restoring them on another install
     or phone leaves stale settings and undecryptable credentials. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
